# Malta Android 10 uses the Microtrust TEE and Beanpod Keymaster 4.0 for FBE.
# Start these services only after the recovery fs trigger has prepared the
# fscrypt keyring and Microtrust device node. The stock Microtrust script
# supplies the TEE daemon arguments and device setup.

import /init.recovery.microtrust.rc
import /vendor/etc/init/android.hardware.light@2.0-service-mediatek.rc

on init
    mkdir /mnt/vendor/persist 0700 root root
    mount ext4 /dev/block/platform/bootdevice/by-name/persist /mnt/vendor/persist

    # Do not export a vendor-first linker path globally. Keystore2 is built
    # against the recovery's libkeymint/libkeymaster ABI and exits before
    # registering when it accidentally loads Malta's Android 10 vendor copy.
    # The legacy HALs that require vendor libraries receive a private path in
    # their service definitions below.

service keymaster-4-0 /system/bin/android.hardware.keymaster@4.0-service.beanpod
    user root
    group root drmrpc
    disabled
    # Beanpod and libkeymaster4 are one ABI set from Malta's stock vendor.
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /system/bin/android.hardware.gatekeeper@1.0-service
    user system
    group system
    disabled
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    seclabel u:r:recovery:s0

on fs
    install_keyring
    setprop crypto.ready 1
    # The active Android 16 GSI created the FBE keymaster blob with this OS
    # identity. Beanpod rejects it with KEY_REQUIRES_UPGRADE when recovery
    # advertises Android 10/2099, and its legacy upgrade command is unsupported.
    exec u:r:recovery:s0 root root -- /sbin/resetprop ro.build.version.release 16
    exec u:r:recovery:s0 root root -- /sbin/resetprop ro.build.version.security_patch 2026-02-01
    # Microtrust's keymaster requires this node before Beanpod starts.
    chown system drmrpc /dev/ut_keymaster
    chmod 0660 /dev/ut_keymaster
    start teei_daemon
    # teei_daemon initializes secure-world asynchronously. Beanpod blocks or
    # fails to register if it is launched before TEEI_BOOT_OK.
    exec u:r:recovery:s0 root root -- /system/bin/sleep 2
    start keymaster-4-0
    start gatekeeper-1-0
    mkdir /tmp/misc 0771 root root
    mkdir /tmp/misc/keystore 0700 root root
    # Keystore2 may have started before the legacy HIDL HAL was registered.
    # Restart it after Beanpod is ready so recovery can unwrap FBE keys.
    exec u:r:recovery:s0 root root -- /system/bin/sleep 1
    restart keystore2

on property:twrp.decrypt.done=true
    stop teei_daemon
    stop keymaster-4-0
    stop gatekeeper-1-0
